<launch>
	<node pkg="eskf_loc" 
				type="eskf_node" 
				name="eskf_node" output="screen">
		<rosparam file="$(find eskf_loc)/config/eskf_param.yaml"/>
		<remap from="/mocap/pose" to="/mocap/JetsonPlatform/pose"/>
	</node>

	<node pkg="rviz"
			type="rviz" 
			name="rviz" 
			args="-d $(find eskf_loc)/config/eskf_rviz.rviz" 
			output="screen"/>

</launch>